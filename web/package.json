    "wasm:build": "wasm-pack build ../crates/rsure-wasm --target web --release"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.9.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^6.3.0",
    "vitest": "^3.0.0"
  }
}
